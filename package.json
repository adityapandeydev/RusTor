{
  "name": "rustor",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/desktop",
    "web"
  ],
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "scripts": {
    "desktop:dev": "bun run --cwd apps/desktop tauri dev",
    "desktop:build": "bun run --cwd apps/desktop tauri build --no-bundle",
    "desktop:package": "bun run scripts/package.mjs",
    "test:packaging": "node --test scripts/package.test.mjs scripts/updater.test.mjs",
    "updater:manifest": "node scripts/updater-manifest.mjs",
    "check": "bun run --cwd apps/desktop check",
    "test": "bun run --cwd apps/desktop test",
    "build": "bun run --cwd apps/desktop build",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:test": "bun run --cwd web test"
  }
}
