{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RusTor",
  "version": "0.2.1",
  "identifier": "dev.adityapandey.rustor",
  "plugins": { "updater": { "pubkey": "", "requireSignedVersion": true, "windows": { "installMode": "passive" } } },
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "RusTor", "visible": false, "width": 1180, "height": 780, "minWidth": 720, "minHeight": 560, "backgroundColor": "#0b3048" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:4173 ws://127.0.0.1:4173"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "publisher": "Aditya Pandey",
    "category": "Utility",
    "shortDescription": "Local-first torrent downloads and discovery",
    "longDescription": "Manage torrent downloads, selected files and seeding with a native Rust engine and desktop interface.",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../../LICENSE": "LICENSE", "../../../README.md": "README.md" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico", "installerHooks": "windows/hooks.nsh" }
    }
  }
}
